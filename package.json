{
	"name": "msdbot_telegram",
	"private": true,
	"license": "MIT",
	"author": {
		"name": "MasedMSD",
		"url": "https://github.com/MasedMSD"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/MSD-Incorporated/MSDBotTelegram"
	},
	"workspaces": [
		"apps/**",
		"packages/**"
	],
	"scripts": {
		"build:bot": "bun build --entrypoint ./apps/bot/src/**.ts --compile --outfile dist/msdbot_telegram --target=bun-linux-x64",
		"build:web": "bun build ./apps/web/src/index.html --outdir=./apps/web/dist --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
		"watch:bot": "bun --watch run ./apps/bot/src/index.ts",
		"watch:web": "bun --hot run ./apps/web/src/index.ts",
		"format": "oxfmt --write '{.github,apps,packages}/**/*.{js,ts,json,md,yml,yaml,css,html}'"
	},
	"devDependencies": {
		"oxfmt": "^0.59.0"
	},
	"packageManager": "bun@1.3.0"
}
